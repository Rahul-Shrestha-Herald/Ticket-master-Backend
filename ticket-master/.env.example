# Ticket Master – Backend environment variables
# Copy this file to .env and fill in your values. Do not commit .env.

# Server
PORT=4000
NODE_ENV=development

# Client (frontend) URL for CORS and redirects
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/ticket-master

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars

# Email (SMTP)
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=noreply@ticketmaster.com

# Google Drive (optional – for bus documents/images and KYC)
# Path to service account JSON key file. Prefer .env over hardcoding.
GOOGLE_APPLICATION_CREDENTIALS=./path-to-your-service-account.json
GOOGLE_DRIVE_BUS_FOLDER_ID=
GOOGLE_DRIVE_PAN_FOLDER_ID=
IMAGE_ACCESS_EMAIL=

# Payment (Khalti)
KHALTI_SECRET_KEY=
